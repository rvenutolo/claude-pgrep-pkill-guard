#!/usr/bin/env bash

# @description Assert the tracked mode of every file this repo cares about.
#              Explicit lists rather than a heuristic: the guard MUST be
#              executable because hooks.json invokes it directly through its
#              shebang, and pgrep-scan.awk MUST NOT be, because it is only ever
#              read by `awk -f`. A heuristic that keys on extension or shebang
#              would get one of those two wrong.
# @arg $1 dir optional fixture directory, treated as the repo root: the tracked
#         file list and modes are read from it rather than from the real
#         checkout. It exists so the bats suite can drive the real matcher over
#         a fabricated tree whose modes are wrong on purpose. Without it the
#         only possible test would be "exits 0 on the real repo", which a
#         script that unconditionally returned 0 would also pass.
# @exitcode 0 every file has its expected mode
# @exitcode 1 at least one file has the wrong mode, an expected-mode row matches
#             no tracked file, or no tracked files were found
# @exitcode 2 more arguments were given than the script accepts

set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# Every positional below is optional, so a surplus argument is a typo, not
# input: exit 2 so "you called it wrong" stays distinguishable from a verdict.
# The ERR trap is dropped first so a usage error reads as a usage error rather
# than as a crash (#43, invariant 6). A top-level guard ahead of the bindings,
# the same file-layout exemption a version guard gets.
if (($# > 1)); then
  printf 'usage: %s [dir]\n' "${0##*/}" >&2
  trap - ERR
  exit 2
fi

readonly FIXTURE_DIR="${1:-}"

# In fixture mode the directory IS the repo root, taken at face value: `git
# rev-parse --show-toplevel` run from a bats temp directory would either fail or
# resolve to some enclosing repo, and the suite would grade the wrong tree.
if [[ -n "${FIXTURE_DIR}" ]]; then
  readonly REPO_DIR="${FIXTURE_DIR}"
else
  REPO_DIR="$(git rev-parse --show-toplevel)"
  readonly REPO_DIR
fi

# Glob patterns, matched against tracked paths.
readonly EXPECT_EXECUTABLE=(
  'hooks/pgrep-pkill-guard.sh'
  '.ci/in-devshell'
  '.ci/build-*'
  '.ci/check-*'
  '.ci/run-*'
  '.ci/report-*'
  '.githooks/*'
  'run-all-checks'
  'run-tests'
  'bench/run'
  'assets/build-social-preview'
)
readonly EXPECT_NON_EXECUTABLE=(
  # Sourced by the guard's entry script (human mode, or once a payload looks
  # worth inspecting), never run on its own: no shebang, so no exec bit
  # either. And the parts it sources.
  'hooks/pgrep-pkill-guard-body.sh'
  'hooks/lib/*.sh'
  'hooks/pgrep-scan.awk'
  'hooks/hooks.json'
  '.ci/required-tools'
  'tests/*.bats'
  'tests/**/*.bash'
  '*.json'
  '*.md'
  '*.nix'
  '*.toml'
  '*.yml'
)

# @description Succeed if any of the given paths matches the glob pattern, with
#              the same `[[ == ]]` match main grades modes by.
# @arg $1 pattern glob pattern from one of the EXPECT_* lists
# @arg $@ tracked paths to test, after the pattern
# @exitcode 0 at least one path matches
# @exitcode 1 no path matches
function pattern_matches_any() {
  local -r pattern="$1"
  shift
  local path
  for path in "$@"; do
    # shellcheck disable=SC2053 # intentional glob match, not a literal compare
    if [[ "${path}" == ${pattern} ]]; then
      return 0
    fi
  done
  return 1
}

function main() {
  local rc=0 meta mode path pattern
  local -a paths=()
  # `git ls-files --stage` prints `<mode> <object> <stage><TAB><path>`, the
  # mode being 100755 or 100644. Split on the tab alone: the script-wide IFS has
  # no space in it, so a `read -r mode _ _ path` would put the whole line before
  # the tab into `mode` and leave `path` empty for every file, grading nothing.
  while IFS=$'\t' read -r meta path; do
    mode="${meta%% *}"
    paths+=("${path}")
    for pattern in "${EXPECT_EXECUTABLE[@]}"; do
      # shellcheck disable=SC2053 # intentional glob match, not a literal compare
      if [[ "${path}" == ${pattern} ]]; then
        if [[ "${mode}" != '100755' ]]; then
          printf 'FAIL: %s must be executable (tracked mode %s)\n' "${path}" "${mode}" >&2
          rc=1
        fi
      fi
    done
    for pattern in "${EXPECT_NON_EXECUTABLE[@]}"; do
      # shellcheck disable=SC2053 # intentional glob match, not a literal compare
      if [[ "${path}" == ${pattern} ]]; then
        if [[ "${mode}" != '100644' ]]; then
          printf 'FAIL: %s must NOT be executable (tracked mode %s)\n' "${path}" "${mode}" >&2
          rc=1
        fi
      fi
    done
  done < <(git -C "${REPO_DIR}" ls-files --stage)

  # An empty scan is a failure, not a clean pass.
  if ((${#paths[@]} == 0)); then
    printf 'FAIL: no tracked files found\n' >&2
    rc=1
  fi

  # A row that matches no tracked file has stopped guarding anything: renaming
  # a literal path, or the last file under a glob, would otherwise drop it from
  # the check without a word. check-shell-shebangs treats a stale exemption row
  # the same way.
  for pattern in "${EXPECT_EXECUTABLE[@]}"; do
    if ! pattern_matches_any "${pattern}" "${paths[@]}"; then
      printf "FAIL: EXPECT_EXECUTABLE entry '%s' matches no tracked file\n" "${pattern}" >&2
      printf '      Drop the row, or restore the file it covers.\n' >&2
      rc=1
    fi
  done
  for pattern in "${EXPECT_NON_EXECUTABLE[@]}"; do
    if ! pattern_matches_any "${pattern}" "${paths[@]}"; then
      printf "FAIL: EXPECT_NON_EXECUTABLE entry '%s' matches no tracked file\n" "${pattern}" >&2
      printf '      Drop the row, or restore the file it covers.\n' >&2
      rc=1
    fi
  done
  # A gate reporting its own verdict is not a crash: drop the ERR trap so the
  # diagnostics above are the last thing the reader sees (#43, invariant 6).
  trap - ERR
  return "${rc}"
}

main "$@"
