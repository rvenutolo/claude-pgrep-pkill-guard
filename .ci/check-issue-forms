#!/usr/bin/env bash

# @description Assert every GitHub issue form under .github/ISSUE_TEMPLATE is
#              one GitHub will actually render. GitHub validates these forms
#              server-side and silently drops any it cannot parse -- a broken
#              form does not error, it just stops appearing in the "New issue"
#              chooser, so nothing short of opening the chooser by hand notices.
#              This gate notices instead. Nothing else in the repo does:
#              yamllint proves a file is YAML, not that it is a form, and
#              `claude plugin validate` never looks at .github at all.
#
#              Nearly all of the checking happens inside two yq programs rather
#              than in bash, the way .ci/check-manifest-invariants puts nearly
#              everything in one jq program; bash only walks the directory,
#              prefixes each emitted line with its filename, and counts.
#
#              Two yq behaviours shape how those programs are written, and both
#              are traps rather than preferences:
#
#              1. `select(COND) | "message"` emits the message even when the
#                 select matched NOTHING -- a string literal is a value operator
#                 that yq still evaluates once against an empty context. Every
#                 rule below therefore collects into an array first
#                 (`[ ... ] | map("message") | .[]`), because map over an empty
#                 array is genuinely empty. Rules joined with `,`, never with
#                 `+`: array `+` here silently discards a mapped operand.
#              2. yq binds `!=` and `==` looser than `or`/`and`, so an
#                 unbracketed `tag != "!!str" or . == ""` collapses to a
#                 constant true and the rule fires on every document. Every
#                 operand is parenthesised for that reason.
#              One rule lives outside those programs, in bash: every label a
#              form declares must exist in .github/labels.yml. It cannot live in
#              a yq program because the existing ones are single-quoted
#              expressions over ONE file and the labels are in a second, and
#              restructuring them to reach it would trade a real rule against
#              the two traps above. A form referencing a label that does not
#              exist does not error either -- GitHub files the issue without it
#              -- so this is the same failure mode as the rest of the file (#89).
# @arg $1 dir optional directory to check; defaults to the repo root plus
#         .github/ISSUE_TEMPLATE. It exists so the bats suite can point the
#         script at a fixture holding one deliberately broken form and assert
#         that it fails. Without it the only possible test would be "exits 0 on
#         the real repo", which a script that always returned 0 would also pass.
# @arg $2 labels optional path to the labels file; defaults to the repo root
#         plus .github/labels.yml. Defaulted to the REAL file rather than
#         derived from $1 on purpose: the suite's form fixtures declare
#         `labels: [bug]`, and `bug` is in the real file, so every pre-existing
#         case keeps passing with one argument. A path derived from $1 would
#         have made a labels fixture mandatory for all of them.
# @exitcode 0 every form and config.yml satisfy the schema, and every label a
#             form references is declared in the labels file
# @exitcode 1 the directory is missing or holds no form, a file is unparsable,
#             the labels file is missing or declares nothing, or a rule is
#             violated

set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

DIR="${1:-$(git rev-parse --show-toplevel)/.github/ISSUE_TEMPLATE}"
LABELS_FILE="${2:-$(git rev-parse --show-toplevel)/.github/labels.yml}"
readonly DIR LABELS_FILE

# config.yml is the chooser configuration, not a form: it carries no name,
# description or body, so it gets its own program below rather than being
# checked as a form and failing all three.
readonly CONFIG_NAME='config.yml'

# One yq program per file kind, each emitting one line per violation. Both are
# single-quoted, so neither may contain an apostrophe -- including in its
# message strings.
#
# $items is a yq binding, not a shell variable; hence the SC2016 disable.
# shellcheck disable=SC2016
readonly FORM_PROGRAM='
[ .body | select((. | tag) == "!!seq") | to_entries | .[] ] as $items
| (
    ( [ .name | select(((. | tag) != "!!str") or (. == "")) ]
      | map("name is missing or is not a non-empty string") | .[] ),

    ( [ .description | select(((. | tag) != "!!str") or (. == "")) ]
      | map("description is missing or is not a non-empty string") | .[] ),

    ( [ .body | select(((. | tag) != "!!seq") or ((. | length) == 0)) ]
      | map("body is missing or is not a non-empty sequence") | .[] ),

    ( [ $items | .[] | select((.value | tag) != "!!map") ]
      | map("body[\(.key)] is not a mapping") | .[] ),

    ( [ $items | .[]
        | select((.value | tag) == "!!map")
        | select((.value.type != "markdown") and (.value.type != "input")
                 and (.value.type != "textarea") and (.value.type != "dropdown")
                 and (.value.type != "checkboxes")) ]
      | map("body[\(.key)] has an unrecognised type: \(.value.type)") | .[] ),

    ( [ $items | .[]
        | select((.value | tag) == "!!map")
        | select(.value.type != "markdown")
        | select(((.value.id | tag) != "!!str") or (.value.id == "")) ]
      | map("body[\(.key)] has no non-empty id") | .[] ),

    ( [ $items | .[]
        | select((.value | tag) == "!!map")
        | select(.value.type != "markdown")
        | select(((.value.attributes.label | tag) != "!!str")
                 or (.value.attributes.label == "")) ]
      | map("body[\(.key)] has no non-empty attributes.label") | .[] ),

    ( [ $items | .[]
        | select((.value | tag) == "!!map")
        | select(.value.type == "markdown")
        | select(((.value.attributes.value | tag) != "!!str")
                 or (.value.attributes.value == "")) ]
      | map("body[\(.key)] is markdown with no non-empty attributes.value") | .[] ),

    ( [ $items | .[]
        | select((.value | tag) == "!!map")
        | select(.value.type == "dropdown")
        | select(((.value.attributes.options | tag) != "!!seq")
                 or ((.value.attributes.options | length) == 0)) ]
      | map("body[\(.key)] is a dropdown with no non-empty attributes.options") | .[] ),

    ( [ $items | .[] | .value.id | select(((. | tag) == "!!str") and (. != "")) ]
      | group_by(.) | map(select((. | length) > 1))
      | map("body id is not unique within the file: \(.[0])") | .[] )
  )
'

readonly CONFIG_PROGRAM='
(
  ( [ .blank_issues_enabled | select((. | tag) != "!!bool") ]
    | map("blank_issues_enabled is missing or is not a boolean") | .[] )
)
'

# @description Print one violation to stderr, in the house format.
# @arg $1 message the violation text
function fail() {
  printf 'FAIL: %s\n' "$1" >&2
}

# @description Assert a file holds parseable YAML. Checked separately from the
#              rule programs so an unparsable file reports as exactly that,
#              rather than as the rule program blowing up on it.
# @arg $1 file path to the YAML file
# @exitcode 0 the file parses
# @exitcode 1 it does not
function check_parses() {
  local -r file="$1"
  if ! yq 'tag' "${file}" > /dev/null 2>&1; then
    fail "${file##*/} is not parseable YAML"
    return 1
  fi
}

# @description Run one yq program over one file and report every line it emits
#              as a violation of that file.
# @arg $1 file path to the YAML file
# @arg $2 program the yq expression to evaluate against it
# @exitcode 0 the program emitted nothing
# @exitcode 1 the program emitted at least one violation, or failed to run
function report_violations() {
  local -r file="$1"
  local -r program="$2"
  local -r label="${file##*/}"

  # Assigned, not read through a process substitution: inside `< <(...)` a yq
  # that died on its own program would report nothing and this script would
  # exit 0 for the wrong reason. Assignment keeps the exit status reachable.
  local output=''
  if ! output="$(yq "${program}" "${file}")"; then
    fail "${label}: the rule program itself failed to run"
    return 1
  fi

  local rc=0 violation
  if [[ -n "${output}" ]]; then
    while IFS= read -r violation; do
      fail "${label}: ${violation}"
      rc=1
    done <<< "${output}"
  fi
  return "${rc}"
}

# @description Print every label name declared in the labels file, one per line.
#              Read ONCE before the form loop rather than per form: the file is
#              the same for all of them, and re-reading it would report a
#              missing labels file once per form.
# @stdout one label name per line
# @exitcode 0 the file parsed and declared at least one label
# @exitcode 1 the file is missing, unparsable, or declares none
function declared_labels() {
  if [[ ! -f "${LABELS_FILE}" ]]; then
    fail "${LABELS_FILE} does not exist"
    return 1
  fi
  local output
  if ! output="$(yq '.[].name' "${LABELS_FILE}" 2> /dev/null)"; then
    fail "${LABELS_FILE##*/} is not parseable YAML"
    return 1
  fi
  # The same guard as the `${#forms[@]} == 0` one below: an empty scan is a
  # failure, never a vacuous pass. Without it a labels file that parsed to an
  # empty sequence would make every form's labels rule trivially satisfied.
  if [[ -z "${output}" ]]; then
    fail "${LABELS_FILE##*/} declares no labels"
    return 1
  fi
  printf '%s\n' "${output}"
}

# @description Assert every label a form declares exists in the labels file.
#              A form referencing a label that does not exist does not error --
#              GitHub silently files the issue without it -- so nothing short of
#              filing one notices (#89).
# @arg $1 file path to the form
# @arg $2 declared newline-separated label names from the labels file
# @exitcode 0 every referenced label is declared
# @exitcode 1 at least one is not, or the form's labels key is unreadable
function check_form_labels() {
  local -r file="$1" declared="$2"
  local -r label="${file##*/}"
  local referenced rc=0 name
  if ! referenced="$(yq '[.labels // [] | .[]] | .[]' "${file}" 2> /dev/null)"; then
    fail "${label}: the labels rule could not read .labels"
    return 1
  fi
  [[ -n "${referenced}" ]] || return 0
  while IFS= read -r name; do
    [[ -n "${name}" ]] || continue
    # `grep --line-regexp --fixed-strings` rather than a bash `[[ ]]` match: a
    # label name may hold a space (`good first issue`) or a colon
    # (`autorelease: pending`), and a substring match would let a declared `bug`
    # satisfy a reference to `bugs`.
    if ! printf '%s\n' "${declared}" | grep --line-regexp --fixed-strings --quiet -- "${name}"; then
      fail "${label}: references label \"${name}\", which ${LABELS_FILE##*/} does not declare"
      rc=1
    fi
  done <<< "${referenced}"
  return "${rc}"
}

function main() {
  if [[ ! -d "${DIR}" ]]; then
    fail "${DIR} does not exist or is not a directory"
    # A gate reporting its own verdict is not a crash: drop the ERR trap so the
    # diagnostics above are the last thing the reader sees (#43, invariant 6).
    trap - ERR
    return 1
  fi

  # `-e` on every candidate rather than `shopt -s nullglob`: an unmatched glob
  # expands to itself, and this script must not depend on nullglob or dotglob
  # state it did not set. Ordering is the shell glob sort, so output is stable.
  local -a forms=()
  local config='' candidate
  for candidate in "${DIR}"/*.yml; do
    [[ -e "${candidate}" ]] || continue
    if [[ "${candidate##*/}" == "${CONFIG_NAME}" ]]; then
      config="${candidate}"
    else
      forms+=("${candidate}")
    fi
  done

  local rc=0

  # An empty scan is a failure, never a vacuous pass -- the same guard as the
  # `count == 0` one in .ci/check-devshell-provides. Without it this script
  # exits 0 on a directory holding no forms at all, which is precisely the
  # regression it exists to catch.
  if ((${#forms[@]} == 0)); then
    fail "${DIR} holds no issue form (a *.yml other than ${CONFIG_NAME})"
    rc=1
  fi

  if [[ -z "${config}" ]]; then
    fail "${DIR}/${CONFIG_NAME} does not exist"
    rc=1
  elif check_parses "${config}"; then
    report_violations "${config}" "${CONFIG_PROGRAM}" || rc=1
  else
    rc=1
  fi

  # Fetched once, before the loop. An unreadable labels file is one violation,
  # not one per form -- and when it is unreadable `declared` is empty, so the
  # per-form rule is skipped rather than reporting every label as undeclared on
  # top of the real diagnosis.
  local declared=''
  declared="$(declared_labels)" || rc=1

  local form
  for form in "${forms[@]}"; do
    if check_parses "${form}"; then
      report_violations "${form}" "${FORM_PROGRAM}" || rc=1
      if [[ -n "${declared}" ]]; then
        check_form_labels "${form}" "${declared}" || rc=1
      fi
    else
      rc=1
    fi
  done

  if ((rc == 0)); then
    printf 'ok: %s issue form(s) and %s satisfy the issue-forms schema, and reference only labels %s declares\n' \
      "${#forms[@]}" "${CONFIG_NAME}" "${LABELS_FILE##*/}" >&2
  fi
  # A gate reporting its own verdict is not a crash: drop the ERR trap so the
  # diagnostics above are the last thing the reader sees (#43, invariant 6).
  trap - ERR
  return "${rc}"
}

main "$@"
