#!/usr/bin/env bash

# @description Assert the plugin manifest satisfies the invariants the official
#              community marketplace checks that apply to a plugin repo -- I3,
#              I4, I10 and I11 of
#              claude-plugins-community/.github/actions/validate-plugins/scripts/11-validate-invariants.sh
#              plus its step-41 parse of hooks.json. Upstream only WARNS on I3
#              by default (WARN_INVARIANTS="I1 I3 I5 I8"; it fails the run only
#              with fail-on-warnings set) -- this port hard-fails it,
#              deliberately stricter than upstream's default. `claude plugin
#              validate` is a schema check and waves every one of these
#              through, so this script is what stands between a careless rename
#              and a marketplace rejection.
#
#              The rest are deliberately absent. I1, I2, I8 and I9 constrain a
#              marketplace manifest's `plugins[]` entries, and this repo ships
#              no marketplace manifest: the plugin is listed in a separate
#              marketplace repo. I5 is upstream's only rule for a `source`, and
#              no source exists in this repo, so no source invariants apply
#              here. I6 and I7 are per-file-mode layout rules for the community
#              repo itself.
#
#              All of the checking happens inside one jq program rather than in
#              bash: the character-class checks among its rules cannot be done
#              portably in shell, because `grep -P` is not guaranteed on macOS,
#              where the gate also runs.
# @arg $1 root optional tree to check; defaults to the git repo root. It exists
#         so the bats suite can point the script at a fixture holding one
#         deliberately broken manifest and assert that it fails. Without it the
#         only possible test would be "exits 0 on the real repo", which a script
#         that always returned 0 would also pass.
# @stderr the `usage:` line on a surplus argument, one `FAIL: <message>` line
#         per missing or unparsable file, per violated invariant and for an
#         invariant program that fails to run, and an `OK:` line when every
#         invariant holds; the ERR trap's `[<script>] ERROR: ...` report when a
#         command fails instead
# @exitcode 0 every invariant holds
# @exitcode 1 a file is missing or unparsable, the invariant program fails to
#             run, or an invariant is violated
# @exitcode 2 more arguments were given than the script accepts
# @exitcode * otherwise the failing git status, when no tree is given and the
#             repository root cannot be resolved

set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# Every positional below is optional, so a surplus argument is a typo -- a
# misplaced flag, a stray path -- not input. Silently ignoring it would run the
# check anyway and report success on something nobody asked for. Exit 2 rather
# than 1: 1 is this script's verdict on what it inspected, and "you called it
# wrong" must stay distinguishable from "what you pointed me at is wrong". The
# ERR trap is dropped first only for symmetry with the verdict returns
# (invariant 6); exit itself never fires it. A top-level guard ahead of the
# bindings, the same file-layout exemption a version guard gets.
if (($# > 1)); then
  printf 'usage: %s [root]\n' "${0##*/}" >&2
  trap - ERR
  exit 2
fi

ROOT="${1:-$(git rev-parse --show-toplevel)}"
readonly ROOT

readonly PLUGIN_JSON="${ROOT}/.claude-plugin/plugin.json"
readonly HOOKS_JSON="${ROOT}/hooks/hooks.json"

# One jq program, emitting one line per violation. Single-quoted, so it must
# contain no apostrophes -- including in its message strings.
#
# hidden_chars lists codepoints by decimal value: 8203-8207 are ZWSP/ZWNJ/ZWJ
# plus the LTR/RTL marks (LRM 8206, RLM 8207), 65279 is the BOM, 8234-8238 are
# the bidi embedding/override controls, and 8294-8297 are the bidi isolates.
# All of them render as nothing and can make two different names look
# identical.
# shellcheck disable=SC2016 # every `$` below is jq source, not a shell expansion
readonly JQ_PROGRAM='
def hidden_chars:
  explode | any(
    (. >= 8203 and . <= 8207) or . == 65279
    or (. >= 8234 and . <= 8238)
    or (. >= 8294 and . <= 8297));

def check_name($label):
  ( if (test("^[a-z0-9][a-z0-9-]{1,63}$") | not)
    then "I11: \($label) name is not ^[a-z0-9][a-z0-9-]{1,63}$: \(.)"
    else empty end ),
  ( if hidden_chars
    then "I10: \($label) name contains a hidden Unicode codepoint"
    else empty end );

def check_description($label):
  ( if (length < 10 or length > 2000)
    then "I3: \($label) description is \(length) characters; must be 10-2000"
    else empty end ),
  ( if (test("^\\s") or test("\\s$"))
    then "I3: \($label) description has leading or trailing whitespace"
    else empty end ),
  ( if hidden_chars
    then "I10: \($label) description contains a hidden Unicode codepoint"
    else empty end );

def check_url($label):
  select(. != null and type == "string")
  | ( if (startswith("https://") | not)
      then "I4: \($label) is not an https URL: \(.)"
      else empty end );

[ ( (.name // "") | check_name("plugin.json") ),
  ( (.description // "") | check_description("plugin.json") ),
  ( .homepage | check_url("plugin.json homepage") ),
  ( .repository | check_url("plugin.json repository") ),
  ( .author.url | check_url("plugin.json author.url") ),
  ( .["$schema"] | check_url("plugin.json $schema") )
] | .[]
'

# @description Print one violation to stderr, in the house format.
# @arg $1 message the violation text
# @stderr the `FAIL: <message>` line
function fail() {
  printf 'FAIL: %s\n' "$1" >&2
}

# @description Assert a file exists and holds parseable JSON. The hooks manifest
#              gets the same treatment as the plugin manifest because the
#              runtime always probes it, and a malformed one is a crash rather
#              than a degraded load.
# @arg $1 file absolute path to the JSON file
# @exitcode 0 the file exists and parses
# @exitcode 1 it is missing or unparsable
function check_parses() {
  local -r file="$1"
  local -r label="${file#"${ROOT}/"}"
  if [[ ! -f "${file}" ]]; then
    fail "${label} does not exist"
    return 1
  fi
  if ! jq --exit-status 'type' "${file}" > /dev/null 2>&1; then
    fail "${label} is not parseable JSON"
    return 1
  fi
}

function main() {
  local rc=0 file
  for file in "${PLUGIN_JSON}" "${HOOKS_JSON}"; do
    check_parses "${file}" || rc=1
  done
  # Every later check indexes into these documents. Running the jq program over
  # a file that did not parse would report the parse error a second time, in a
  # worse format.
  if ((rc != 0)); then
    # A gate reporting its own verdict is not a crash: drop the ERR trap so the
    # parse errors above are the last thing the reader sees (invariant 6).
    trap - ERR
    return "${rc}"
  fi

  # Assigned, not read through a process substitution: inside `< <(...)` a jq
  # that died on its own program would report nothing and this script would exit
  # 0 for the wrong reason. Assignment keeps the exit status reachable.
  local output=''
  if ! output="$(jq --raw-output "${JQ_PROGRAM}" "${PLUGIN_JSON}")"; then
    fail 'the invariant program itself failed to run'
    # A gate reporting its own verdict is not a crash: drop the ERR trap so the
    # diagnostics above are the last thing the reader sees (invariant 6).
    trap - ERR
    return 1
  fi

  local violation
  if [[ -n "${output}" ]]; then
    while IFS= read -r violation; do
      fail "${violation}"
      rc=1
    done <<< "${output}"
  fi

  if ((rc == 0)); then
    printf 'OK: plugin.json satisfies I3, I4, I10 and I11, and hooks.json parses\n' >&2
  fi
  # A gate reporting its own verdict is not a crash: drop the ERR trap so the
  # diagnostics above are the last thing the reader sees (invariant 6).
  trap - ERR
  return "${rc}"
}

main "$@"
