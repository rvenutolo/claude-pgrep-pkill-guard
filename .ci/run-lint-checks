#!/usr/bin/env bash

# @description Run the config/markup lint suite: actionlint, yamllint,
#              renovate-config-validator, markdownlint, typos,
#              editorconfig-checker, and shellcheck over every tracked shell
#              script. Aggregates exit codes rather than failing fast, so one
#              run surfaces every failing category.
# @noargs
# @exitcode 0 every linter passed
# @exitcode 1 at least one linter failed

set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR

# @description Log a step banner to stderr.
# @arg $1 message the text to log
function log() {
  local -r message="$1"
  printf '[%s] %s\n' "${0##*/}" "${message}" >&2
}

# @description Collect tracked shell scripts: *.sh plus extensionless files whose
#              first line is a bash shebang. `git ls-files` rather than a tree
#              walk so untracked scratch files are never linted.
# @noargs
# @stdout one path per line
function shell_files() {
  local file
  while IFS= read -r file; do
    case "${file}" in
      *.sh | *.bash) printf '%s\n' "${file}" ;;
      *.bats | *.awk | *.md | *.json | *.yml | *.yaml | *.toml | *.nix | *.lock) ;;
      *)
        if [[ -f "${file}" ]] && IFS= read -r first_line < "${file}" \
          && [[ "${first_line}" == '#!/usr/bin/env bash' ]]; then
          printf '%s\n' "${file}"
        fi
        ;;
    esac
  done < <(git -C "${REPO_DIR}" ls-files)
}

function main() {
  local rc=0
  local -a files=()
  mapfile -t files < <(shell_files)

  log 'running shellcheck'
  if ((${#files[@]} > 0)); then
    # LC_ALL is scoped to shellcheck on purpose. The hermetic devShell sets no
    # locale, and shellcheck (Haskell) then encodes its output as ASCII and dies
    # with "commitBuffer: invalid argument" the moment a finding lands on a line
    # containing an em dash — of which this repo's scripts have many. The
    # diagnostic is swallowed mid-sentence, so the failure reads as a mystery.
    LC_ALL=C.UTF-8 shellcheck "${files[@]}" || rc=1
  else
    log 'no shell files found — this is a failure, not a clean pass'
    rc=1
  fi

  log 'running shfmt (verify only)'
  if ((${#files[@]} > 0)); then
    shfmt --list --diff "${files[@]}" || rc=1
  fi

  log 'running actionlint'
  if [[ -d "${REPO_DIR}/.github/workflows" ]]; then
    actionlint || rc=1
  fi

  log 'running yamllint'
  yamllint --strict . || rc=1

  log 'running renovate-config-validator'
  # --no-global is required, not cosmetic: a config named on the command line is
  # validated against the GLOBAL self-hosted schema by default, and
  # .github/renovate.json is a repo config. Explicit path rather than bare
  # auto-discovery because the bare form resolves the default filenames relative
  # to the CURRENT directory and, finding none, exits 0 with only a warning --
  # a gate that passes by looking at nothing. Without any of this a malformed
  # config is not a CI failure: Renovate just stops opening dependency PRs.
  renovate-config-validator --no-global "${REPO_DIR}/.github/renovate.json" || rc=1

  log 'running markdownlint'
  # Tracked files only. markdownlint does not honour gitignore, so a glob would
  # lint the untracked docs/superpowers/ tree and redden every local gate.
  local -a md_files=()
  mapfile -t md_files < <(git -C "${REPO_DIR}" ls-files '*.md')
  if ((${#md_files[@]} > 0)); then
    markdownlint-cli2 "${md_files[@]}" || rc=1
  fi

  log 'running typos'
  # Explicit file list, not a bare `typos`. Bare `typos` walks the tree and
  # SKIPS HIDDEN PATHS, so it silently covered 22 of ~50 tracked files: none of
  # .ci/, .github/, .claude-plugin/ or .githooks/ was ever spell-checked, and
  # the gate reported a clean pass regardless (#46). `--hidden` is the wrong fix
  # -- it also picks up UNTRACKED hidden paths, which here means the author's
  # docs/superpowers/ and .claude/ trees.
  #
  # `git grep -I --files-with-matches ''` is every tracked file git considers
  # text: it matches every line, so it names every file, and -I drops the
  # binaries. Passing assets/deny-message.png explicitly would make typos read
  # compressed bytes as prose and report a dozen findings from them.
  local -a typo_files=()
  mapfile -t typo_files < <(git -C "${REPO_DIR}" grep -I --files-with-matches '')
  if ((${#typo_files[@]} > 0)); then
    typos "${typo_files[@]}" || rc=1
  else
    log 'no text files found for typos - this is a failure, not a clean pass'
    rc=1
  fi

  log 'running editorconfig-checker'
  editorconfig-checker || rc=1

  if ((rc != 0)); then
    log 'one or more linters failed'
  fi
  # A gate reporting its own verdict is not a crash: drop the ERR trap so the
  # diagnostics above are the last thing the reader sees (#43, invariant 6).
  trap - ERR
  return "${rc}"
}

main "$@"
