root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{sh,bash,bats}]
shell_variant = bash
binary_next_line = true
switch_case_indent = true
space_redirects = true

# The repo's extensionless bash scripts. shfmt resolves its style per path, so
# without these sections it falls back to its own defaults for anything that is
# not *.sh and rejects the formatting the rest of the repo is written in.
[{run-all-checks,run-tests}]
shell_variant = bash
binary_next_line = true
switch_case_indent = true
space_redirects = true

[.ci/**]
shell_variant = bash
binary_next_line = true
switch_case_indent = true
space_redirects = true

[.githooks/**]
shell_variant = bash
binary_next_line = true
switch_case_indent = true
space_redirects = true

[bench/**]
shell_variant = bash
binary_next_line = true
switch_case_indent = true
space_redirects = true

[assets/**]
shell_variant = bash
binary_next_line = true
switch_case_indent = true
space_redirects = true

[*.md]
trim_trailing_whitespace = false
