#!/usr/bin/env bash

# @description Run the full local verification gate: the formatting check, the
#              governance lints, the benchmark smoke run, the lint suite, and
#              the BATS suite -- the last under gawk and again under
#              one-true-awk, because the hook must behave identically on both,
#              unless `--awk` picks one. Verify-only
#              — it never rewrites the tree, which is why `nix fmt` is a separate
#              step run before it. Exit codes are AGGREGATED rather than failing
#              fast, so a single run surfaces every failing category instead of
#              only the first.
#
#              `--scope=shared` runs only the platform-neutral checks: the
#              formatting check, every governance lint but
#              `.ci/check-devshell-provides`, and the lint suite.
#              `--scope=platform` runs only what can pass on one platform and
#              fail on another: `.ci/check-devshell-provides`, which grades the
#              devShell of the host it runs on, `bench/run --smoke`, which drives
#              the hook under the host's awk, and the suite. CI runs the shared
#              scope once, on Linux, and the platform scope on every gate leg, so
#              no leg pays for a check whose verdict cannot differ between them.
#              Without `--scope`, as in a local run, both run.
#
#              `--awk=gawk` or `--awk=bwk` runs the suite under that awk
#              alone. CI uses it to give each gate leg one awk -- gawk on
#              Linux, one-true-awk on macOS, where it is the stock awk -- so
#              neither leg pays for the suite twice. Without it, as in a local
#              run, the suite runs under both.
#
#              `--report DIR` is forwarded to each suite run as
#              `--report DIR/<awk>` (`gawk` or `bwk`), so each gets its own
#              JUnit report rather than one overwriting the other.
#              Nothing else in the gate emits a report; the flag exists so CI
#              can upload the suite's results as an artifact when a leg fails.
#
#              `--slice I/N`, under `--scope=platform` only, is forwarded to
#              each suite run, which then runs only slice I of N of the files
#              (see run-tests), and the platform checks run only in slice 0.
#              CI uses it to split one platform's suite across runners, each
#              running one slice, so that together they run every file once
#              and each platform check once. Under any other scope the shared
#              checks would run in every slice, so it is rejected there.
# @arg $@ args optional `--scope=shared` or `--scope=platform`, optional
#         `--awk=gawk` or `--awk=bwk`, optional `--report DIR` with exactly
#         one non-empty directory not starting with `--`, and optional
#         `--slice I/N` with a slice index I from 0 below a slice count N, each
#         at most once, in any order; `--awk` and `--report` only shape the
#         suite, so neither combines with `--scope=shared`, and `--slice`
#         needs `--scope=platform`
# @exitcode 0 every check passed
# @exitcode 1 one or more checks failed
# @exitcode 2 any arguments other than those
# @exitcode * otherwise the failing git status, when the repository root cannot
#             be resolved
# @stderr a `[<script>] <message>` banner before each step, a warning naming
#         each untracked file, `one or more checks failed` on exit 1, and the
#         usage line on exit 2; the ERR trap's `[<script>] ERROR: ...` report
#         when a command fails instead

set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR

# @description Log a step banner to stderr, in the house format.
# @arg $1 message the text to log
# @stderr the `[<script>] <message>` line
function log() {
  local -r message="$1"
  printf '[%s] %s\n' "${0##*/}" "${message}" >&2
}

# @description Warn when the working tree holds untracked, non-ignored files.
#              `nix flake check` evaluates the git tree, so an untracked file is
#              invisible to the formatting gate and passes vacuously. Never
#              fails the run — blocking on scratch files would be worse.
# @noargs
function warn_untracked() {
  local -a untracked=()
  mapfile -t untracked < <(git -C "${REPO_DIR}" ls-files --others --exclude-standard)
  if ((${#untracked[@]} == 0)); then
    return 0
  fi
  log 'untracked files are invisible to nix flake check; git add them:'
  local file
  for file in "${untracked[@]}"; do
    log "  untracked: ${file}"
  done
}

# @description Print the usage line and exit 2. Exit 2 rather than 1: 1 is the
#              gate's verdict, and "you called it wrong" must stay
#              distinguishable from it. The ERR trap is dropped first
#              only for symmetry with the verdict returns (invariant 6);
#              exit itself never fires it.
# @noargs
# @stderr the usage line
# @exitcode 2 always
function usage() {
  printf 'usage: %s [--scope=shared|--scope=platform] [--awk=gawk|--awk=bwk] [--report DIR] [--slice I/N]\n' \
    "${0##*/}" >&2
  trap - ERR
  exit 2
}

function main() {
  # Anything outside the documented arguments is a typo -- a bare --report, a
  # --report whose directory is the next flag, a misspelt flag or awk name, a
  # repeated flag, a stray extra argument -- and
  # silently running the gate without it would hand a caller who asked for a
  # report a green run and nothing to upload, or a caller who asked for one awk
  # a run under both.
  local report_dir='' awk='' scope='' slice=''
  while (($# > 0)); do
    case "$1" in
      '--scope=shared' | '--scope=platform')
        if [[ -n "${scope}" ]]; then
          usage
        fi
        scope="${1#--scope=}"
        shift
        ;;
      '--awk=gawk' | '--awk=bwk')
        if [[ -n "${awk}" ]]; then
          usage
        fi
        awk="${1#--awk=}"
        shift
        ;;
      '--report')
        if [[ -n "${report_dir}" ]] || (($# < 2)) || [[ -z "$2" || "$2" == --* ]]; then
          usage
        fi
        report_dir="$2"
        shift 2
        ;;
      '--slice')
        # The shape run-tests accepts: no leading zero, an index below the count.
        if [[ -n "${slice}" ]] || (($# < 2)) || [[ ! "$2" =~ ^(0|[1-9][0-9]*)/([1-9][0-9]*)$ ]] \
          || ((BASH_REMATCH[1] >= BASH_REMATCH[2])); then
          usage
        fi
        slice="$2"
        shift 2
        ;;
      *) usage ;;
    esac
  done
  # The shared scope runs no suite, so a caller asking for an awk or a report
  # alongside it would get a green run without the suite run it asked to shape.
  if [[ "${scope}" == 'shared' ]] && [[ -n "${awk}" || -n "${report_dir}" ]]; then
    usage
  fi
  # Only the platform scope knows which of its checks belong to one slice;
  # without it the shared checks would run again on every slice's runner.
  if [[ -n "${slice}" && "${scope}" != 'platform' ]]; then
    usage
  fi
  local -a slice_args=()
  local platform_checks='y'
  if [[ -n "${slice}" ]]; then
    slice_args=(--slice "${slice}")
    if [[ "${slice%/*}" != '0' ]]; then
      platform_checks=''
    fi
  fi

  # Each suite run gets its own subdirectory. Without --awk, run-all-checks runs
  # the suite under gawk and AGAIN under one-true-awk, and a shared output directory
  # means the later run overwrites the earlier. Losing the gawk report
  # when the bwk run also failed is exactly the case the artifact exists for.
  local -a gawk_report=() bwk_report=()
  if [[ -n "${report_dir}" ]]; then
    gawk_report=(--report "${report_dir}/gawk")
    bwk_report=(--report "${report_dir}/bwk")
  fi

  # Each check is guarded by the scope that excludes it rather than grouped by
  # scope, so a run without --scope keeps one order: formatting, governance,
  # lint, suite.
  local rc=0
  if [[ "${scope}" != 'platform' ]]; then
    warn_untracked
    log 'running nix flake check (formatting)'
    nix flake check --no-eval-cache "${REPO_DIR}" || rc=1
  fi

  # Repo-consistency checks: devshell inputs match flake outputs, executable
  # bits and shebangs are correct on the right files, the guard's entry script
  # stays under the line ceiling that keeps its per-call parse cost small, every
  # script that installs the ERR trap clears it before its own deliberate
  # non-zero return so a verdict never reads as a crash, external sources are
  # SHA-pinned, versions agree across manifests, the bats libraries are pinned
  # to the same SHAs on both sides of the hermetic boundary, the
  # marketplace/plugin manifests satisfy the ported invariants, and every
  # .github/ISSUE_TEMPLATE form is one GitHub will render rather than silently
  # drop from the chooser.
  # check-invariant-markers turns docs/architecture.md's "Design invariants"
  # section from description into enforcement: that section promises each rule
  # is repeated as a comment in the source it constrains, and that promise
  # needs enforcing: a marker wrapped across a line break is invisible to the
  # grep the doc tells a reader to run. It is a presence check over
  # a table of phrases, collapsing line breaks and `#` continuations first, so
  # rewrapping a comment stays allowed and deleting one does not.
  # check-guard-parts holds the loader's GUARD_PARTS table to what is actually
  # under hooks/lib/. The loader pins one function name per part as a STRING
  # and proves a part loaded by calling `declare -F` on it, so a rename
  # that misses the table makes the guard print INACTIVE and allow the command
  # through. The bats suite catches that at test time -- every case reaching the
  # body gets INACTIVE instead of a verdict -- and this gate catches it at lint
  # time. It checks the reverse direction too: a part no row names is never
  # sourced, so every function in it is undefined at runtime.
  # check-shell-shebangs asserts that every tracked file carrying a shebang
  # carries `#!/usr/bin/env bash`, or is one of the named exemptions with the
  # exact spelling it is allowed. run-lint-checks admits an extensionless file
  # into shellcheck and shfmt only when its first line matches that string
  # exactly, and drops any other bash spelling from BOTH linters with no
  # diagnostic -- its empty-scan guard fires only when the list is entirely
  # empty, never when it is one file short. The one exemption,
  # .ci/check-inactive-on-old-bash, is named in the gate's table, so it is
  # skipped by name rather than by mechanism -- the latter is indistinguishable
  # from that bug.
  # check-bench-fresh compares the commit bench/RESULTS.md records in its
  # provenance table against the hooks/ history since. The README quotes that
  # report's figures as measured, and nothing else ties them to the code:
  # hooks/ can move on, even through a change the benchmark exists to measure,
  # while the report still names an older commit. More verdicts
  # than pass and fail -- the recorded commit can also be present but
  # unreachable (its branch was rewritten), which is reported with different
  # wording because no comparison happened at all, or absent from the object
  # store, which is a SKIP
  # so that a shallow clone never gets a red gate over history it never fetched.
  # The last is the release-please version line: it lives inside hooks/, so
  # every release PR carried a hooks/ diff. A net difference confined to that
  # one line passes. And the stale and unreachable verdicts convict only under
  # BENCH_FRESH_STRICT, which ci.yml sets on release-please's branch alone:
  # everywhere else the gate warns, because a wall-clock benchmark is a
  # release-time cost, not a per-PR one.
  # bench/run --smoke drives one payload of each kind of row through the hook
  # and checks every response parses as JSON. It asserts NOTHING about timing
  # -- a timing assertion would be flaky on a shared runner. Its only job is
  # that the benchmark harness cannot rot silently when the hook's interface or
  # the corpus's shape changes.
  # Deliberately excluded from this list: .ci/run-plugin-validate. This gate is
  # hermetic -- every tool in it comes from the flake -- and a step whose
  # behaviour depends on an ambient `claude` would make the gate
  # non-deterministic; see that script's own header for the full rationale.
  # check-devshell-provides and bench/run --smoke are the platform scope's.
  # check-devshell-provides grades the devShell of the host it runs on, so only
  # a macOS run catches a darwin devShell missing a tool; bench/run --smoke
  # drives the hook under the host's awk. Under --slice both run in slice 0
  # alone, so each still runs once per platform.
  if [[ "${scope}" != 'platform' || -n "${platform_checks}" ]]; then
    log 'running governance checks'
  fi
  if [[ "${scope}" != 'shared' && -n "${platform_checks}" ]]; then
    "${REPO_DIR}/.ci/check-devshell-provides" || rc=1
  fi
  if [[ "${scope}" != 'platform' ]]; then
    "${REPO_DIR}/.ci/check-executable-bit" || rc=1
    "${REPO_DIR}/.ci/check-bats-no-shebang" || rc=1
    "${REPO_DIR}/.ci/check-shell-shebangs" || rc=1
    "${REPO_DIR}/.ci/check-fast-path-size" || rc=1
    "${REPO_DIR}/.ci/check-guard-parts" || rc=1
    "${REPO_DIR}/.ci/check-err-trap-hygiene" || rc=1
    "${REPO_DIR}/.ci/check-uses-sha-pinned" || rc=1
    "${REPO_DIR}/.ci/check-versions-in-sync" || rc=1
    "${REPO_DIR}/.ci/check-manifest-invariants" || rc=1
    "${REPO_DIR}/.ci/check-issue-forms" || rc=1
    "${REPO_DIR}/.ci/check-invariant-markers" || rc=1
    "${REPO_DIR}/.ci/check-bench-fresh" || rc=1
  fi
  if [[ "${scope}" != 'shared' && -n "${platform_checks}" ]]; then
    "${REPO_DIR}/bench/run" --smoke || rc=1
  fi

  if [[ "${scope}" != 'platform' ]]; then
    log 'running lint checks'
    "${REPO_DIR}/.ci/run-lint-checks" || rc=1
  fi

  if [[ "${scope}" != 'shared' && "${awk}" != 'bwk' ]]; then
    log 'running tests (gawk)'
    "${REPO_DIR}/run-tests" "${gawk_report[@]}" "${slice_args[@]}" || rc=1
  fi

  if [[ "${scope}" != 'shared' && "${awk}" != 'gawk' ]]; then
    log 'running tests (one-true-awk)'
    "${REPO_DIR}/run-tests" --awk=bwk "${bwk_report[@]}" "${slice_args[@]}" || rc=1
  fi

  if ((rc != 0)); then
    log 'one or more checks failed'
  fi
  # A gate reporting its own verdict is not a crash: drop the ERR trap so the
  # diagnostics above are the last thing the reader sees (invariant 6).
  trap - ERR
  return "${rc}"
}

main "$@"
