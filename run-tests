#!/usr/bin/env bash

# @description Run the BATS suite under tests/, or forward arguments directly to
#              bats. Snapshots repo state (HEAD, config, index) before and after
#              and dies loudly if the suite mutated the real repo, even when bats
#              itself exited 0 — the repeat-tier cases create state dirs,
#              symlinks and large fixture files, so fixture escape is a real risk.
#
#              bats itself runs serially: `bats --jobs` needs flock and GNU
#              parallel, both Linux-only in nixpkgs, and referencing them would
#              break evaluation of the devShell on aarch64-darwin.
#              `tests/classify.bats` shards its rows across plain background
#              jobs instead, which need neither.
#
#              `--awk=bwk` runs the suite with `awk` resolving to one-true-awk
#              (the nawk the devShell provides), which is the stock awk on macOS.
#              The hook and its scanner resolve `awk` from PATH, so a shim dir
#              holding a single `awk -> nawk` symlink, prepended to PATH, is all
#              it takes to exercise that platform from Linux. The default run
#              keeps whatever `awk` the devShell puts first (gawk). Repeating
#              the flag is the same as giving it once.
#
#              `--report DIR` adds bats' JUnit reporter, which writes
#              DIR/report.xml while leaving the terminal formatter alone --
#              `--report-formatter`, not `--formatter`, because the compat legs'
#              job logs are the first thing a reader looks at when a macOS-only
#              failure appears and swapping them for XML would trade the
#              artifact against the thing it exists to supplement (#83). DIR is
#              created if absent, because bats requires `--output` to name a
#              directory that already exists. The report lands whether the suite
#              passed or failed; the failing case is the one it exists for.
#
#              `--coverage DIR` runs the suite under kcov and writes an HTML
#              line-coverage report for hooks/ into DIR (open DIR/index.html).
#              Linux only: nixpkgs' kcov declares no darwin platform, so the
#              devShell carries it only on Linux. The measured scope is
#              `--include-path=hooks/` and nothing else -- coverage of the suite
#              itself is not the question, and including it would bury the
#              hooks/ files that matter. kcov instruments bash by exporting
#              BASH_ENV, which tests/test_helper/common.bash unsets unless
#              COVERAGE is set, so this flag exports COVERAGE=1; without that the
#              report is 0.00% with no files (#91).
#
#              Under --coverage each .bats file runs as its own bats under its
#              own kcov, as many at once as there are CPUs, and `kcov --merge`
#              combines them into DIR/kcov-merged/. kcov reads one trace pipe per
#              process, so separate processes never interleave their traces and
#              the merged report matches what one kcov over the whole suite
#              records. A file named classify.bats is split into twice as many
#              CLASSIFY_SLICE slices as there are CPUs, because its rows are most
#              of the suite's time under kcov. Each file's output is printed
#              once every file has finished, in queue order, and with --report
#              each writes its JUnit file to its own subdirectory of the report
#              DIR. Arguments that name a file or directory are the files to
#              run, and naming none is an error; `--recursive` (or `-r`) chooses
#              whether a directory is walked recursively, and any other argument
#              is passed to every bats.
# @arg $@ args optional `--awk=bwk`, `--report DIR` and `--coverage DIR` in any
#         order, then bats arguments and test paths; give neither to run all
#         of tests/
# @stdout the bats terminal output (each file's in turn, under --coverage)
# @stderr a `[<script>] <message>` line naming the awk in use under --awk=bwk or
#         the number of kcov processes under --coverage, kcov's own trace spill
#         under --coverage, a `[<script>] <message>` line for a file that left
#         no exit status, a
#         `[<script>] FATAL: <message>` line on each exit-1 cause this script
#         detects, or the bash-version message; the ERR trap's
#         `[<script>] ERROR: ...` report when a command fails instead
# @exitcode 0 all tests passed and the repo was left untouched
# @exitcode 1 bats missing, nawk missing or not one-true-awk under --awk=bwk,
#             kcov missing under --coverage, --report or --coverage given
#             without a directory or with one that cannot be created, a test
#             failed, the suite mutated the repo, or the host bash is older
#             than 4.4
# @exitcode * otherwise the failing git status when the repository root cannot be
#             resolved, or the status bats or kcov exited with

set -Eeuo pipefail
# `inherit_errexit` is a bash 4.4 builtin option: on stock macOS bash 3.2, and
# on 4.2 or 4.3, the shell aborts with `shopt: inherit_errexit: invalid shell
# option name`, which tells a coworker running ./run-tests nothing about what to
# install. Check first, and say what to do. Must stay ABOVE the `shopt` line it
# is protecting.
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  printf '%s: bash 4.4+ required to run the suite (found %s.%s). On macOS: brew install bash.\n' \
    "${0##*/}" "${BASH_VERSINFO[0]}" "${BASH_VERSINFO[1]}" >&2
  exit 1
fi
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
# Temporary directories for the EXIT trap to remove, registered through
# remove_on_exit. One list behind one trap, because --awk=bwk and --coverage
# each make one and an EXIT trap holds a single command.
TEMP_DIRS=()
# The suite's status under --coverage, set by run_coverage. A global rather than
# run_coverage's return status, so main calls it outside a `||` list and a
# failing mktemp, mkdir or `kcov --merge` inside it still trips errexit and the
# ERR trap instead of passing silently.
SUITE_STATUS=0

# @description Print one fatal diagnostic to stderr and exit 1.
# @arg $1 message the diagnostic text
# @stderr the `[<script>] FATAL: <message>` line
# @exitcode 1 always
function die() {
  printf '[%s] FATAL: %s\n' "${0##*/}" "$1" >&2
  exit 1
}

# @description Remove every directory registered with remove_on_exit. The EXIT
#              trap's command.
# @noargs
function remove_temp_dirs() {
  if ((${#TEMP_DIRS[@]} > 0)); then
    rm --recursive --force -- "${TEMP_DIRS[@]}"
  fi
}

# @description Register a temporary directory for removal on exit, and arm the
#              EXIT trap that removes it.
# @arg $1 dir the directory to remove on exit
# @set TEMP_DIRS dir, appended
function remove_on_exit() {
  local -r dir="$1"
  TEMP_DIRS+=("${dir}")
  trap remove_temp_dirs EXIT
}

# @description Print one line per watched repo artifact: HEAD sha, config hash,
#              index hash. Used before and after the suite to detect fixture
#              escapes onto the real repo.
# @noargs
# @stdout one KEY=value line per watched artifact
function repo_state() {
  local head_ref config_hash index_hash config_path index_path
  head_ref="$(git -C "${REPO_DIR}" rev-parse --quiet --verify HEAD || printf 'NO-HEAD')"
  config_path="$(git -C "${REPO_DIR}" rev-parse --path-format=absolute --git-path 'config')"
  index_path="$(git -C "${REPO_DIR}" rev-parse --path-format=absolute --git-path 'index')"
  config_hash="$([[ -f "${config_path}" ]] && git hash-object "${config_path}" || printf 'ABSENT')"
  index_hash="$([[ -f "${index_path}" ]] && git hash-object "${index_path}" || printf 'ABSENT')"
  printf 'HEAD=%s\nconfig=%s\nindex=%s\n' "${head_ref}" "${config_hash}" "${index_hash}"
}

# @description Prepend a shim directory to PATH in which `awk` is one-true-awk,
#              then prove the swap took by version string: BWK prints
#              `awk version YYYYMMDD`, gawk `GNU Awk`, mawk `mawk`. A suite that
#              silently ran under gawk would pass for the wrong reason.
# @noargs
# @set PATH the one-true-awk shim directory, prepended
# @set TEMP_DIRS the shim directory, appended through remove_on_exit
# @exitcode 0 `awk` now resolves to one-true-awk
# @exitcode 1 nawk is not on PATH, or the shim did not take (via die)
function use_bwk_awk() {
  local nawk shim version
  if ! nawk="$(command -v nawk)"; then
    die "nawk not found on PATH — --awk=bwk needs the devShell's one-true-awk"
  fi
  shim="$(mktemp --directory)"
  remove_on_exit "${shim}"
  ln --symbolic "${nawk}" "${shim}/awk"
  export PATH="${shim}:${PATH}"
  version="$(awk --version 2>&1 | head --lines=1)"
  case "${version}" in
    'awk version '*) log "awk is one-true-awk: ${version}" ;;
    *) die "expected one-true-awk at the head of PATH, got: ${version}" ;;
  esac
}

# @description Log a step banner to stderr, in the house format.
# @arg $1 message the text to log
# @stderr the `[<script>] <message>` line
function log() {
  printf '[%s] %s\n' "${0##*/}" "$1" >&2
}

# @description Run one queued .bats file under its own kcov, writing its stdout,
#              stderr and exit status to files under <work>/log/, and its kcov
#              output to <work>/kcov/<label>. Run in the background by
#              run_coverage; the status file is written last, so a run that dies
#              early leaves none and run_coverage can tell.
# @arg $1 path the .bats file
# @arg $2 slice the CLASSIFY_SLICE value to export, or the empty string
# @arg $3 label the name of this item's output files and directories
# @arg $4 work the temporary directory holding every item's output
# @arg $5 report_dir the --report directory, or the empty string for none
# @arg $@ bats_args after the first five, arguments passed to bats
# @stdout nothing; the item's output goes to its files
function run_item() {
  local -r path="$1" slice="$2" label="$3" work="$4" report_dir="$5"
  shift 5
  local -a report_args=()
  if [[ -n "${report_dir}" ]]; then
    mkdir --parents "${report_dir}/${label}"
    report_args=(--report-formatter junit --output "${report_dir}/${label}")
  fi
  local status=0
  CLASSIFY_SLICE="${slice}" kcov "--include-path=${REPO_DIR}/hooks" "${work}/kcov/${label}" \
    bats "${report_args[@]}" "$@" "${path}" \
    > "${work}/log/${label}.out" 2> "${work}/log/${label}.err" || status=$?
  printf '%s\n' "${status}" > "${work}/log/${label}.status"
}

# @description Run the suite as parallel kcov processes and merge their reports
#              into the coverage directory. The queue holds the files largest
#              first, then a classify.bats as slices, so the small slices even
#              out the finish.
# @arg $1 coverage_dir the --coverage directory
# @arg $2 report_dir the --report directory, or the empty string for none
# @arg $@ args after the first two, bats arguments and test paths; none runs
#         every .bats file under tests/
# @set SUITE_STATUS 0 when every file passed, 1 when a file left no exit
#                   status, otherwise the first non-zero status a file's kcov or
#                   bats exited with
# @stdout each file's bats output, in queue order
# @stderr the queue size and worker count, each file's stderr in queue order,
#         and a `[<script>] <message>` line for a file that left no exit status
# @exitcode 0 the files ran and their reports were merged
# @exitcode 1 the arguments name no .bats file (via die)
function run_coverage() {
  local -r coverage_dir="$1" report_dir="$2"
  shift 2
  local -a bats_args=() files=() dir_files=()
  local arg recursive=''
  for arg in "$@"; do
    case "${arg}" in
      '--recursive' | '-r') recursive='y' ;;
      *) ;;
    esac
  done
  if (($# == 0)); then
    bats_args=(--print-output-on-failure)
    recursive='y'
    set -- "${REPO_DIR}/tests"
  fi
  for arg in "$@"; do
    if [[ -d "${arg}" ]]; then
      if [[ -n "${recursive}" ]]; then
        mapfile -t dir_files < <(find "${arg}" -name '*.bats' -type f | sort)
      else
        mapfile -t dir_files < <(find "${arg}" -maxdepth 1 -name '*.bats' -type f | sort)
      fi
      files+=("${dir_files[@]}")
    elif [[ -f "${arg}" ]]; then
      files+=("${arg}")
    else
      case "${arg}" in
        '--recursive' | '-r') ;;
        *) bats_args+=("${arg}") ;;
      esac
    fi
  done
  if ((${#files[@]} == 0)); then
    die '--coverage found no .bats file to run in the given arguments'
  fi

  local workers
  workers="$(nproc)"
  # Parallel arrays, one entry per queued item: the file, the CLASSIFY_SLICE
  # value it runs with (empty for a whole file), and its output label.
  local -a item_paths=() item_slices=() item_labels=() sized=()
  local line path name slice_file='' i
  mapfile -t sized < <(stat --format=$'%s\t%n' -- "${files[@]}" | sort --numeric-sort --reverse)
  for line in "${sized[@]}"; do
    path="${line#*$'\t'}"
    if [[ "${path##*/}" == 'classify.bats' ]]; then
      slice_file="${path}"
      continue
    fi
    item_paths+=("${path}")
    item_slices+=('')
    name="${path##*/}"
    item_labels+=("${#item_paths[@]}-${name%.bats}")
  done
  if [[ -n "${slice_file}" ]]; then
    local -r slices="$((2 * workers))"
    for ((i = 0; i < slices; i++)); do
      item_paths+=("${slice_file}")
      item_slices+=("${i}/${slices}")
      item_labels+=("${#item_paths[@]}-classify-${i}")
    done
  fi

  local work
  work="$(mktemp --directory)"
  remove_on_exit "${work}"
  mkdir --parents "${work}/kcov" "${work}/log"
  log "running ${#item_paths[@]} files and slices under kcov, ${workers} at a time"
  local running=0
  for ((i = 0; i < ${#item_paths[@]}; i++)); do
    if ((running >= workers)); then
      wait -n || true # each item's own status is in its status file, read below
      running="$((running - 1))"
    fi
    run_item "${item_paths[i]}" "${item_slices[i]}" "${item_labels[i]}" "${work}" "${report_dir}" \
      "${bats_args[@]}" &
    running="$((running + 1))"
  done
  wait

  local label item_status status=0
  for label in "${item_labels[@]}"; do
    cat -- "${work}/log/${label}.out"
    cat -- "${work}/log/${label}.err" >&2
    item_status=''
    if [[ -f "${work}/log/${label}.status" ]]; then
      read -r item_status < "${work}/log/${label}.status" || true # an empty file is caught below
    fi
    if [[ ! "${item_status}" =~ ^[0-9]+$ ]]; then
      log "${label} left no exit status"
      item_status=1
    fi
    if ((status == 0 && item_status != 0)); then
      status="${item_status}"
    fi
  done

  kcov --merge "${coverage_dir}" "${work}/kcov/"*
  SUITE_STATUS="${status}"
}

function main() {
  # Unset BASH_ENV so bats' per-test subshells do not re-source the user's
  # interactive ~/.bashrc. That re-source fires for every test subshell, making
  # the suite dramatically slower and clobbering exported vars in child shells.
  #
  # This is NOT the unset that had to be guarded for `--coverage`, and it must
  # stay unconditional -- do not "fix" it for symmetry with the guarded one in
  # tests/test_helper/common.bash. It runs here, before the kcov process below
  # is started, and kcov exports its own BASH_ENV into the environment it hands
  # its child; clearing an inherited interactive BASH_ENV first is exactly what
  # we want, and it cannot suppress the one kcov sets afterwards. The unset in
  # common.bash is different because that file is sourced *inside* the traced
  # tree, after kcov has injected.
  unset BASH_ENV

  if ! command -v bats > /dev/null 2>&1; then
    die "bats not found on PATH — run './.ci/in-devshell ./run-tests' or 'just test'"
  fi

  # Leading flags, in any order, consumed before anything reaches bats. A loop
  # rather than a chain of `if`s so `--awk=bwk --report DIR` and
  # `--report DIR --awk=bwk` are the same invocation -- CI passes one, a person
  # debugging locally passes the other, and an order-dependent parse would make
  # one of them silently forward `--awk=bwk` to bats as a test path. `--coverage`
  # joins the same loop for the same reason: it has to compose with both of the
  # others, in either direction.
  local report_dir='' coverage_dir='' awk_swapped=''
  while (($# > 0)); do
    case "$1" in
      '--awk=bwk')
        shift
        # Once only: a second call for a repeated flag would stack a second
        # shim directory ahead of the first for no effect.
        if [[ -z "${awk_swapped}" ]]; then
          use_bwk_awk
          awk_swapped='y'
        fi
        ;;
      '--report')
        if (($# < 2)); then
          die '--report needs a directory argument'
        fi
        report_dir="$2"
        shift 2
        ;;
      '--coverage')
        if (($# < 2)); then
          die '--coverage needs a directory argument'
        fi
        coverage_dir="$2"
        shift 2
        ;;
      *) break ;;
    esac
  done

  local -a report_args=()
  if [[ -n "${report_dir}" ]]; then
    # bats' own --help says the --output directory "must exist"; it does not
    # create one. Creating it here is what makes `--report` safe to point at a
    # per-run path like ${RUNNER_TEMP}/bats-junit that nothing else made.
    #
    # A short flag only where macOS has no long form, deliberately, like every
    # other line on run-tests' ambient path (the --coverage mkdir and
    # `uname -s` below). The rest of run-tests keeps GNU long options because
    # every one of them sits on a devShell-only path -- `use_bwk_awk`'s
    # `mktemp --directory`, `ln --symbolic` and `head --lines=1` are reachable
    # only under `--awk=bwk`, which needs the devShell's nawk anyway, and
    # `run_coverage`'s and `run_item`'s only under `--coverage`, which needs the
    # devShell's Linux-only kcov; `remove_temp_dirs` runs only once one of those
    # two has armed the EXIT trap. This line
    # is not: `compat (ubuntu, ambient)` and `compat (macos, homebrew bash)`
    # both invoke ./run-tests directly against the tools the runner ships, and
    # BSD mkdir has no --parents: there `mkdir --parents` dies with
    # `mkdir: illegal option -- -` before a single test runs, and the upload
    # step this directory exists to feed finds nothing to upload.
    # bash-style allow=long-options: runs on the ambient macOS leg; BSD mkdir has no long form
    mkdir -p "${report_dir}"
    # --report-formatter, NOT --formatter: --report-formatter writes JUnit to a
    # file and leaves the terminal formatter alone, --formatter REPLACES
    # terminal output.
    # The compat legs' job logs are the first thing a reader looks at when a
    # macOS-only failure appears, and swapping them for XML would trade the
    # artifact against the thing it exists to supplement (#83).
    report_args=(--report-formatter junit --output "${report_dir}")
  fi

  if [[ -n "${coverage_dir}" ]]; then
    if ! command -v kcov > /dev/null 2>&1; then
      # Genuinely different failures, and the wrong message sends a reader
      # off to install something that does not exist for their platform.
      # bash-style allow=long-options: reachable on macOS outside the devShell; BSD uname has no long form
      case "$(uname -s)" in
        'Darwin')
          die 'kcov not found — nixpkgs ships no darwin kcov, so --coverage is Linux-only (#91)'
          ;;
        *)
          die "kcov not found on PATH — run './.ci/in-devshell ./run-tests --coverage DIR' or 'just coverage'"
          ;;
      esac
    fi
    # kcov creates its output directory itself, so this is not load-bearing the
    # way --report's mkdir is; it is here so --report and --coverage behave
    # identically and a CI path is safe to name before the tool runs. A short
    # flag only where
    # macOS has no long form, for the reason spelled out on --report's
    # `mkdir -p` above -- this line is on the ambient-tool path too.
    # bash-style allow=long-options: reachable outside the devShell; BSD mkdir has no long form
    mkdir -p "${coverage_dir}"
    # The one caller of COVERAGE. tests/test_helper/common.bash unsets BASH_ENV
    # for fixture hygiene unless it sees this, and BASH_ENV is the channel kcov
    # instruments bash through; without the export the report is 0.00% with no
    # files (#91). Exported here rather than in the fixture so a bare `bats` run
    # never sees it.
    export COVERAGE=1
  fi

  local before after status=0
  before="$(repo_state)"
  if [[ -n "${coverage_dir}" ]]; then
    run_coverage "${coverage_dir}" "${report_dir}" "$@"
    status="${SUITE_STATUS}"
  elif (($# == 0)); then
    bats --recursive --print-output-on-failure "${report_args[@]}" "${REPO_DIR}/tests" || status=$?
  else
    bats "${report_args[@]}" "$@" || status=$?
  fi
  after="$(repo_state)"

  if [[ "${before}" != "${after}" ]]; then
    die "test suite mutated the real repo — before: [${before//$'\n'/ }] after: [${after//$'\n'/ }]"
  fi
  # A gate reporting its own verdict is not a crash: drop the ERR trap so the
  # bats output above is the last thing the reader sees (#43, invariant 6).
  trap - ERR
  return "${status}"
}

main "$@"
