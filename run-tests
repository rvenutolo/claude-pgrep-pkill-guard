#!/usr/bin/env bash

# @description Run the BATS suite under tests/, or the .bats files the arguments
#              name. Snapshots repo state (HEAD, config, index) before and after
#              and dies loudly if the suite mutated the real repo, even when
#              every file passed — the repeat-tier cases create state dirs,
#              symlinks and large fixture files, so fixture escape is a real risk.
#
#              Each .bats file runs as its own bats, as many at once as `--jobs
#              N` allows (default: the number of CPUs online). The pool is plain
#              background jobs, not `bats --jobs`: that needs flock and GNU
#              parallel, both Linux-only in nixpkgs, and referencing them would
#              break evaluation of the devShell on aarch64-darwin. Files are
#              queued largest first, so the longest ones start early and the
#              small ones even out the finish. Each file's stdout and stderr go
#              to files of their own and are printed whole, in queue order, once
#              every file has finished, so one file's output never interleaves
#              with another's and the failing file reads as one block. The exit
#              status is the first non-zero one in queue order, or 1 for a file
#              that left none. An INT or TERM stops every running file, and
#              everything its bats started, before run-tests exits.
#
#              Arguments that name a file or directory are the files to run;
#              naming none runs all of tests/, walked recursively, and naming no
#              argument at all also adds `--print-output-on-failure`.
#              `--recursive` (or `-r`) chooses whether a named directory is
#              walked recursively, and any other argument is passed to every
#              bats.
#
#              `--awk=bwk` runs the suite with `awk` resolving to one-true-awk
#              (the nawk the devShell provides), which is the stock awk on macOS.
#              The hook and its scanner resolve `awk` from PATH, so a shim dir
#              holding a single `awk -> nawk` symlink, prepended to PATH, is all
#              it takes to exercise that platform from Linux. The default run
#              keeps whatever `awk` the devShell puts first (gawk). Repeating
#              the flag is the same as giving it once.
#
#              `--report DIR` adds bats' JUnit reporter, which writes one
#              report per file into its own subdirectory of DIR while leaving
#              the terminal formatter alone -- `--report-formatter`, not
#              `--formatter`, because the compat legs' job logs are the first
#              thing a reader looks at when a macOS-only failure appears and
#              swapping them for XML would trade the artifact against the thing
#              it exists to supplement (#83). A subdirectory each, because
#              files that shared one would leave only the report of the last to
#              finish. DIR is created if absent, because bats requires
#              `--output` to name a directory that already exists. The reports
#              land whether the suite passed or failed; the failing case is the
#              one they exist for.
#
#              `--coverage DIR` runs the suite under kcov and writes an HTML
#              line-coverage report for hooks/ into DIR (open DIR/index.html).
#              Linux only: nixpkgs' kcov declares no darwin platform, so the
#              devShell carries it only on Linux. The measured scope is
#              `--include-path=hooks/` and nothing else -- coverage of the suite
#              itself is not the question, and including it would bury the
#              hooks/ files that matter. kcov instruments bash by exporting
#              BASH_ENV, which tests/test_helper/common.bash unsets unless
#              COVERAGE is set, so this flag exports COVERAGE=1; without that the
#              report is 0.00% with no files (#91).
#
#              Under --coverage each file's bats runs under its own kcov, and
#              `kcov --merge` combines them into DIR/kcov-merged/. kcov reads
#              one trace pipe per process, so separate processes never
#              interleave their traces; see docs/architecture.md, "Line
#              coverage", for how the split still moves the figure. A file named
#              classify.bats is split into CLASSIFY_SLICES slices through its
#              CLASSIFY_SLICE variable, queued after every other file, because
#              its rows are most of the suite's time under kcov. Naming no file
#              while passing other arguments is an error under --coverage.
# @arg $@ args optional `--awk=bwk`, `--report DIR`, `--jobs N` and
#         `--coverage DIR` in any order, then bats arguments and test paths;
#         give no test path to run all of tests/
# @stdout each file's bats terminal output, in queue order
# @stderr a `[<script>] <message>` line naming the awk in use under --awk=bwk,
#         the number of files and workers, each file's stderr in queue order,
#         kcov's own trace spill under --coverage, a `[<script>] <message>`
#         line for a file that left no exit status, a
#         `[<script>] FATAL: <message>` line on each exit-1 cause this script
#         detects, or the bash-version message; the ERR trap's
#         `[<script>] ERROR: ...` report when a command fails instead
# @exitcode 0 all tests passed and the repo was left untouched
# @exitcode 1 bats missing, nawk missing or not one-true-awk under --awk=bwk,
#             kcov missing under --coverage, --report or --coverage given
#             without a directory or with one that cannot be created, --jobs
#             given without a positive whole number, no .bats file named under
#             --coverage, a test failed, a file left no exit status, the suite
#             mutated the repo, or the host bash is older than 4.4
# @exitcode 130 interrupted by INT
# @exitcode 143 stopped by TERM
# @exitcode * otherwise the failing git status when the repository root cannot be
#             resolved, or the status bats or kcov exited with

set -Eeuo pipefail
# `inherit_errexit` is a bash 4.4 builtin option: on stock macOS bash 3.2, and
# on 4.2 or 4.3, the shell aborts with `shopt: inherit_errexit: invalid shell
# option name`, which tells a coworker running ./run-tests nothing about what to
# install. Check first, and say what to do. Must stay ABOVE the `shopt` line it
# is protecting.
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  printf '%s: bash 4.4+ required to run the suite (found %s.%s). On macOS: brew install bash.\n' \
    "${0##*/}" "${BASH_VERSINFO[0]}" "${BASH_VERSINFO[1]}" >&2
  exit 1
fi
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
# Temporary directories for the EXIT trap to remove, registered through
# remove_on_exit. One list behind one trap, because --awk=bwk and the pool
# each make one and an EXIT trap holds a single command.
TEMP_DIRS=()
# The suite's status, set by run_suite. A global rather than run_suite's return
# status, so main calls it outside a `||` list and a failing mktemp, mkdir or
# `kcov --merge` inside it still trips errexit and the ERR trap instead of
# passing silently.
SUITE_STATUS=0
# The .bats files to run and the arguments every bats gets, set by
# collect_files.
FILES=()
BATS_ARGS=()
# The queue, set by queue_items as parallel arrays, one entry per item: the
# file, the CLASSIFY_SLICE value it runs with (empty to leave the variable
# alone), and the label naming its output files and report directory.
ITEM_PATHS=()
ITEM_SLICES=()
ITEM_LABELS=()
# Each started worker's process id, which is also its process group id, and
# the status file it writes last, as parallel arrays. Globals because
# stop_workers runs from a trap, outside run_suite's scope.
WORKER_PIDS=()
WORKER_STATUS_FILES=()
# How many slices --coverage splits a classify.bats into. Fixed rather than
# derived from the CPU count: the split decides which lines kcov's apostrophe
# swallow windows hide (#128), so it must be the same on every machine for the
# figure to be. Twice CI's 4 CPUs, so the slices even out the finish there.
readonly CLASSIFY_SLICES=8

# @description Print one fatal diagnostic to stderr and exit 1.
# @arg $1 message the diagnostic text
# @stderr the `[<script>] FATAL: <message>` line
# @exitcode 1 always
function die() {
  printf '[%s] FATAL: %s\n' "${0##*/}" "$1" >&2
  exit 1
}

# @description Remove every directory registered with remove_on_exit. The EXIT
#              trap's command.
# @noargs
function remove_temp_dirs() {
  if ((${#TEMP_DIRS[@]} > 0)); then
    # bash-style allow=long-options: the pool arms this on the ambient macOS leg; BSD rm has no long form
    rm -r -f -- "${TEMP_DIRS[@]}"
  fi
}

# @description Register a temporary directory for removal on exit, and arm the
#              EXIT trap that removes it.
# @arg $1 dir the directory to remove on exit
# @set TEMP_DIRS dir, appended
function remove_on_exit() {
  local -r dir="$1"
  TEMP_DIRS+=("${dir}")
  trap remove_temp_dirs EXIT
}

# @description Print one line per watched repo artifact: HEAD sha, config hash,
#              index hash. Used before and after the suite to detect fixture
#              escapes onto the real repo.
# @noargs
# @stdout one KEY=value line per watched artifact
function repo_state() {
  local head_ref config_hash index_hash config_path index_path
  head_ref="$(git -C "${REPO_DIR}" rev-parse --quiet --verify HEAD || printf 'NO-HEAD')"
  config_path="$(git -C "${REPO_DIR}" rev-parse --path-format=absolute --git-path 'config')"
  index_path="$(git -C "${REPO_DIR}" rev-parse --path-format=absolute --git-path 'index')"
  config_hash="$([[ -f "${config_path}" ]] && git hash-object "${config_path}" || printf 'ABSENT')"
  index_hash="$([[ -f "${index_path}" ]] && git hash-object "${index_path}" || printf 'ABSENT')"
  printf 'HEAD=%s\nconfig=%s\nindex=%s\n' "${head_ref}" "${config_hash}" "${index_hash}"
}

# @description Prepend a shim directory to PATH in which `awk` is one-true-awk,
#              then prove the swap took by version string: BWK prints
#              `awk version YYYYMMDD`, gawk `GNU Awk`, mawk `mawk`. A suite that
#              silently ran under gawk would pass for the wrong reason.
# @noargs
# @set PATH the one-true-awk shim directory, prepended
# @set TEMP_DIRS the shim directory, appended through remove_on_exit
# @exitcode 0 `awk` now resolves to one-true-awk
# @exitcode 1 nawk is not on PATH, or the shim did not take (via die)
function use_bwk_awk() {
  local nawk shim version
  if ! nawk="$(command -v nawk)"; then
    die "nawk not found on PATH — --awk=bwk needs the devShell's one-true-awk"
  fi
  shim="$(mktemp --directory)"
  remove_on_exit "${shim}"
  ln --symbolic "${nawk}" "${shim}/awk"
  export PATH="${shim}:${PATH}"
  version="$(awk --version 2>&1 | head --lines=1)"
  case "${version}" in
    'awk version '*) log "awk is one-true-awk: ${version}" ;;
    *) die "expected one-true-awk at the head of PATH, got: ${version}" ;;
  esac
}

# @description Log a step banner to stderr, in the house format.
# @arg $1 message the text to log
# @stderr the `[<script>] <message>` line
function log() {
  printf '[%s] %s\n' "${0##*/}" "$1" >&2
}

# @description Print how many CPUs the host has online: nproc's count, else
#              getconf's, else BSD sysctl's, else 1. Each is missing somewhere
#              this runs: the devShell carries nproc but neither of the others,
#              and stock macOS, which the ambient macOS leg runs on, has no
#              nproc. One worker is always correct, only slower, so it is the
#              last resort rather than a failure.
# @noargs
# @stdout the CPU count, a positive whole number
function cpu_count() {
  local count=''
  count="$(nproc 2> /dev/null)" || count='' # a failed probe falls through to the next
  if [[ ! "${count}" =~ ^[1-9][0-9]*$ ]]; then
    count="$(getconf _NPROCESSORS_ONLN 2> /dev/null)" || count='' # a failed probe falls through to the next
  fi
  if [[ ! "${count}" =~ ^[1-9][0-9]*$ ]]; then
    count="$(sysctl -n hw.ncpu 2> /dev/null)" || count='' # a failed probe falls through to 1
  fi
  if [[ ! "${count}" =~ ^[1-9][0-9]*$ ]]; then
    count=1
  fi
  printf '%s\n' "${count}"
}

# @description Split arguments into the .bats files to run and the arguments to
#              pass to every bats. One naming a directory adds the .bats files
#              under it, sorted, walked recursively when `--recursive` or `-r`
#              is among the arguments; one naming a file adds that file; any
#              other, apart from `--recursive` and `-r` themselves, is a bats
#              argument.
# @arg $@ args bats arguments and test paths
# @set FILES the .bats files, in argument order
# @set BATS_ARGS the other arguments, in order
function collect_files() {
  local -a dir_files=()
  local arg recursive=''
  FILES=()
  BATS_ARGS=()
  for arg in "$@"; do
    case "${arg}" in
      '--recursive' | '-r') recursive='y' ;;
      *) ;;
    esac
  done
  for arg in "$@"; do
    if [[ -d "${arg}" ]]; then
      if [[ -n "${recursive}" ]]; then
        mapfile -t dir_files < <(find "${arg}" -name '*.bats' -type f | sort)
      else
        mapfile -t dir_files < <(find "${arg}" -maxdepth 1 -name '*.bats' -type f | sort)
      fi
      FILES+=("${dir_files[@]}")
    elif [[ -f "${arg}" ]]; then
      FILES+=("${arg}")
    else
      case "${arg}" in
        '--recursive' | '-r') ;;
        *) BATS_ARGS+=("${arg}") ;;
      esac
    fi
  done
}

# @description Append one item to the queue, labelled by its queue position and
#              the given name.
# @arg $1 path the .bats file
# @arg $2 slice the CLASSIFY_SLICE value to run it with, or the empty string
# @arg $3 name the label's name part
# @set ITEM_PATHS path, appended
# @set ITEM_SLICES slice, appended
# @set ITEM_LABELS `<position>-<name>`, appended
function queue_item() {
  local -r path="$1" slice="$2" name="$3"
  ITEM_PATHS+=("${path}")
  ITEM_SLICES+=("${slice}")
  ITEM_LABELS+=("${#ITEM_PATHS[@]}-${name}")
}

# @description Queue FILES largest first, by byte count, a tie keeping argument
#              order. Under --coverage a classify.bats is held back and queued
#              last as CLASSIFY_SLICES slices, so the small slices even out the
#              finish. Without --coverage it keeps its place by size: it already
#              grades its rows in a shard per CPU, and on a 3- or 4-CPU host the
#              whole suite finished 10-25 s later with it queued first, whole or
#              split into a slice per worker, than in size order, because its
#              shards then crowd the largest file, the run's long pole.
# @arg $1 coverage non-empty under --coverage
# @set ITEM_PATHS the queued files
# @set ITEM_SLICES each item's CLASSIFY_SLICE value
# @set ITEM_LABELS each item's label
function queue_items() {
  local -r coverage="$1"
  local -a sizes=() order=()
  local file size i j swap slice_file='' name
  for file in "${FILES[@]}"; do
    # Not `stat`: its size option is spelled differently by GNU and BSD.
    # bash-style allow=long-options: runs on the ambient macOS leg; BSD wc has no long form
    size="$(wc -c < "${file}")"
    sizes+=("$((size))")
  done
  # An insertion sort in bash, because `sort` spells a numeric reverse
  # differently across the userlands this runs on, and the list is short.
  for ((i = 0; i < ${#FILES[@]}; i++)); do
    order+=("${i}")
    for ((j = ${#order[@]} - 1; j > 0; j--)); do
      if ((sizes[order[j - 1]] >= sizes[order[j]])); then
        break
      fi
      swap="${order[j - 1]}"
      order[j - 1]="${order[j]}"
      order[j]="${swap}"
    done
  done
  ITEM_PATHS=()
  ITEM_SLICES=()
  ITEM_LABELS=()
  for i in "${order[@]}"; do
    file="${FILES[i]}"
    if [[ -n "${coverage}" && "${file##*/}" == 'classify.bats' ]]; then
      slice_file="${file}"
      continue
    fi
    name="${file##*/}"
    queue_item "${file}" '' "${name%.bats}"
  done
  if [[ -n "${slice_file}" ]]; then
    for ((i = 0; i < CLASSIFY_SLICES; i++)); do
      queue_item "${slice_file}" "${i}/${CLASSIFY_SLICES}" "classify-${i}"
    done
  fi
}

# @description Run one queued item as its own bats, writing its stdout, stderr
#              and exit status to files under <work>/log/. Run in the
#              background by run_suite; the status file is written last, so a
#              run that dies early leaves none and run_suite can tell.
# @arg $1 path the .bats file
# @arg $2 slice the CLASSIFY_SLICE value to export, or the empty string to
#         leave the variable alone
# @arg $3 label the name of this item's output files and directories
# @arg $4 work the temporary directory holding every item's output
# @arg $5 report_dir the --report directory, or the empty string for none
# @arg $6 coverage non-empty to run bats under kcov, writing to
#         <work>/kcov/<label>
# @arg $@ bats_args after the first six, arguments passed to bats
# @set CLASSIFY_SLICE slice, exported, when slice is not empty
# @stdout nothing; the item's output goes to its files
function run_item() {
  local -r path="$1" slice="$2" label="$3" work="$4" report_dir="$5" coverage="$6"
  shift 6
  local -a report_args=() kcov_args=()
  if [[ -n "${report_dir}" ]]; then
    # bash-style allow=long-options: runs on the ambient macOS leg; BSD mkdir has no long form
    mkdir -p "${report_dir}/${label}"
    report_args=(--report-formatter junit --output "${report_dir}/${label}")
  fi
  if [[ -n "${coverage}" ]]; then
    kcov_args=(kcov "--include-path=${REPO_DIR}/hooks" "${work}/kcov/${label}")
  fi
  if [[ -n "${slice}" ]]; then
    # This function runs in its own background subshell, so the export
    # reaches this item's bats and nothing else.
    export CLASSIFY_SLICE="${slice}"
  fi
  local status=0
  "${kcov_args[@]}" bats "${report_args[@]}" "$@" "${path}" \
    > "${work}/log/${label}.out" 2> "${work}/log/${label}.err" || status=$?
  printf '%s\n' "${status}" > "${work}/log/${label}.status"
}

# @description Stop every worker that has not finished, then exit. The INT and
#              TERM traps' command while the pool runs. Each worker leads its
#              own process group, so one kill reaches its bats and everything
#              that bats started; killing the worker's own process alone would
#              orphan them to run on after run-tests has gone.
# @arg $1 status the status to exit with, 128 plus the signal's number
# @exitcode * always status
function stop_workers() {
  local -r status="$1"
  local i
  trap - INT TERM
  for i in "${!WORKER_PIDS[@]}"; do
    # A finished worker's group id may already belong to an unrelated process.
    if [[ ! -f "${WORKER_STATUS_FILES[i]}" ]]; then
      kill -TERM -- "-${WORKER_PIDS[i]}" 2> /dev/null || true # the group can end between the test and the kill
    fi
  done
  wait
  exit "${status}"
}

# @description Run the queue as background workers, at most `jobs` at once, and
#              print each item's output in queue order once every one has
#              finished. Under --coverage each item runs under its own kcov and
#              the reports are merged into the coverage directory.
# @arg $1 jobs the most items to run at once
# @arg $2 report_dir the --report directory, or the empty string for none
# @arg $3 coverage_dir the --coverage directory, or the empty string for none
# @arg $@ bats_args after the first three, arguments passed to every bats
# @set SUITE_STATUS 0 when every item passed, 1 when an item left no exit
#                   status, otherwise the first non-zero status an item's bats
#                   or kcov exited with, in queue order
# @set WORKER_PIDS each started worker's process id, appended
# @set WORKER_STATUS_FILES each started worker's status file, appended
# @set TEMP_DIRS the work directory, appended through remove_on_exit
# @stdout each item's bats output, in queue order
# @stderr the queue size and worker count, each item's stderr in queue order,
#         and a `[<script>] <message>` line for an item that left no exit
#         status
# @exitcode 0 the items ran, and under --coverage their reports were merged
# @exitcode 130 interrupted by INT (via stop_workers)
# @exitcode 143 stopped by TERM (via stop_workers)
function run_suite() {
  local -r jobs="$1" report_dir="$2" coverage_dir="$3"
  shift 3
  local work
  # bash-style allow=long-options: runs on the ambient macOS leg; BSD mktemp has no long form
  work="$(mktemp -d)"
  remove_on_exit "${work}"
  mkdir "${work}/log"
  if [[ -n "${coverage_dir}" ]]; then
    mkdir "${work}/kcov"
    log "running ${#ITEM_PATHS[@]} files and slices under kcov, ${jobs} at a time"
  else
    log "running ${#ITEM_PATHS[@]} files, ${jobs} at a time"
  fi
  trap 'stop_workers 130' INT
  trap 'stop_workers 143' TERM
  local running=0 i
  for ((i = 0; i < ${#ITEM_PATHS[@]}; i++)); do
    if ((running >= jobs)); then
      wait -n || true # each item's own status is in its status file, read below
      running="$((running - 1))"
    fi
    # Job control on for this one fork, so the worker leads a process group of
    # its own that stop_workers can kill whole. Off again straight after,
    # because with it on every foreground command would get a group of its own
    # too. stdin from /dev/null: a background group that read the terminal
    # would stop the run.
    set -m
    run_item "${ITEM_PATHS[i]}" "${ITEM_SLICES[i]}" "${ITEM_LABELS[i]}" "${work}" "${report_dir}" \
      "${coverage_dir}" "$@" < /dev/null &
    set +m
    WORKER_PIDS+=("$!")
    WORKER_STATUS_FILES+=("${work}/log/${ITEM_LABELS[i]}.status")
    running="$((running + 1))"
  done
  wait
  trap - INT TERM

  local label item_status status=0
  for label in "${ITEM_LABELS[@]}"; do
    cat -- "${work}/log/${label}.out"
    cat -- "${work}/log/${label}.err" >&2
    item_status=''
    if [[ -f "${work}/log/${label}.status" ]]; then
      read -r item_status < "${work}/log/${label}.status" || true # an empty file is caught below
    fi
    if [[ ! "${item_status}" =~ ^[0-9]+$ ]]; then
      log "${label} left no exit status"
      item_status=1
    fi
    if ((status == 0 && item_status != 0)); then
      status="${item_status}"
    fi
  done

  if [[ -n "${coverage_dir}" ]]; then
    kcov --merge "${coverage_dir}" "${work}/kcov/"*
  fi
  SUITE_STATUS="${status}"
}

function main() {
  # Unset BASH_ENV so bats' per-test subshells do not re-source the user's
  # interactive ~/.bashrc. That re-source fires for every test subshell, making
  # the suite dramatically slower and clobbering exported vars in child shells.
  #
  # This is NOT the unset that had to be guarded for `--coverage`, and it must
  # stay unconditional -- do not "fix" it for symmetry with the guarded one in
  # tests/test_helper/common.bash. It runs here, before the kcov process below
  # is started, and kcov exports its own BASH_ENV into the environment it hands
  # its child; clearing an inherited interactive BASH_ENV first is exactly what
  # we want, and it cannot suppress the one kcov sets afterwards. The unset in
  # common.bash is different because that file is sourced *inside* the traced
  # tree, after kcov has injected.
  unset BASH_ENV

  if ! command -v bats > /dev/null 2>&1; then
    die "bats not found on PATH — run './.ci/in-devshell ./run-tests' or 'just test'"
  fi

  # Leading flags, in any order, consumed before anything reaches bats. A loop
  # rather than a chain of `if`s so `--awk=bwk --report DIR` and
  # `--report DIR --awk=bwk` are the same invocation -- CI passes one, a person
  # debugging locally passes the other, and an order-dependent parse would make
  # one of them silently forward `--awk=bwk` to bats as a test path. `--jobs`
  # and `--coverage` join the same loop for the same reason: each has to
  # compose with the others, in either direction.
  local report_dir='' coverage_dir='' awk_swapped='' jobs=''
  while (($# > 0)); do
    case "$1" in
      '--awk=bwk')
        shift
        # Once only: a second call for a repeated flag would stack a second
        # shim directory ahead of the first for no effect.
        if [[ -z "${awk_swapped}" ]]; then
          use_bwk_awk
          awk_swapped='y'
        fi
        ;;
      '--report')
        if (($# < 2)); then
          die '--report needs a directory argument'
        fi
        report_dir="$2"
        shift 2
        ;;
      '--jobs')
        # No leading zero, so the value never reads as octal in arithmetic.
        if (($# < 2)) || [[ ! "$2" =~ ^[1-9][0-9]*$ ]]; then
          die '--jobs needs a positive whole number'
        fi
        jobs="$2"
        shift 2
        ;;
      '--coverage')
        if (($# < 2)); then
          die '--coverage needs a directory argument'
        fi
        coverage_dir="$2"
        shift 2
        ;;
      *) break ;;
    esac
  done

  if [[ -n "${report_dir}" ]]; then
    # bats' own --help says the --output directory "must exist"; it does not
    # create one. Creating it here is what makes `--report` safe to point at a
    # per-run path like ${RUNNER_TEMP}/bats-junit that nothing else made.
    #
    # A short flag only where macOS has no long form, deliberately, like every
    # other line on run-tests' ambient path (the pool's `mktemp -d`, `wc -c`,
    # and `rm -r -f`, the --coverage mkdir and `uname -s` below).
    # The rest of run-tests keeps GNU long options because every one of them
    # sits on a devShell-only path -- `use_bwk_awk`'s `mktemp --directory`,
    # `ln --symbolic` and `head --lines=1` are reachable only under
    # `--awk=bwk`, which needs the devShell's nawk anyway. This line is not:
    # `compat (ubuntu, ambient)` and `compat (macos, homebrew bash)` both
    # invoke ./run-tests directly against the tools the runner ships, and BSD
    # mkdir has no --parents: there `mkdir --parents` dies with
    # `mkdir: illegal option -- -` before a single test runs, and the upload
    # step this directory exists to feed finds nothing to upload.
    # bash-style allow=long-options: runs on the ambient macOS leg; BSD mkdir has no long form
    mkdir -p "${report_dir}"
  fi

  if [[ -n "${coverage_dir}" ]]; then
    if ! command -v kcov > /dev/null 2>&1; then
      # Genuinely different failures, and the wrong message sends a reader
      # off to install something that does not exist for their platform.
      # bash-style allow=long-options: reachable on macOS outside the devShell; BSD uname has no long form
      case "$(uname -s)" in
        'Darwin')
          die 'kcov not found — nixpkgs ships no darwin kcov, so --coverage is Linux-only (#91)'
          ;;
        *)
          die "kcov not found on PATH — run './.ci/in-devshell ./run-tests --coverage DIR' or 'just coverage'"
          ;;
      esac
    fi
    # kcov creates its output directory itself, so this is not load-bearing the
    # way --report's mkdir is; it is here so --report and --coverage behave
    # identically and a CI path is safe to name before the tool runs. A short
    # flag only where
    # macOS has no long form, for the reason spelled out on --report's
    # `mkdir -p` above -- this line is on the ambient-tool path too.
    # bash-style allow=long-options: reachable outside the devShell; BSD mkdir has no long form
    mkdir -p "${coverage_dir}"
    # The one caller of COVERAGE. tests/test_helper/common.bash unsets BASH_ENV
    # for fixture hygiene unless it sees this, and BASH_ENV is the channel kcov
    # instruments bash through; without the export the report is 0.00% with no
    # files (#91). Exported here rather than in the fixture so a bare `bats` run
    # never sees it.
    export COVERAGE=1
  fi

  if (($# == 0)); then
    set -- '--print-output-on-failure' '--recursive' "${REPO_DIR}/tests"
  fi
  collect_files "$@"
  if ((${#FILES[@]} == 0)); then
    if [[ -n "${coverage_dir}" ]]; then
      die '--coverage found no .bats file to run in the given arguments'
    fi
    collect_files "$@" '--recursive' "${REPO_DIR}/tests"
  fi
  if [[ -z "${jobs}" ]]; then
    jobs="$(cpu_count)"
  fi
  queue_items "${coverage_dir}"

  local before after
  before="$(repo_state)"
  run_suite "${jobs}" "${report_dir}" "${coverage_dir}" "${BATS_ARGS[@]}"
  after="$(repo_state)"

  if [[ "${before}" != "${after}" ]]; then
    die "test suite mutated the real repo — before: [${before//$'\n'/ }] after: [${after//$'\n'/ }]"
  fi
  # A gate reporting its own verdict is not a crash: drop the ERR trap so the
  # bats output above is the last thing the reader sees (#43, invariant 6).
  trap - ERR
  return "${SUITE_STATUS}"
}

main "$@"
