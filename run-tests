#!/usr/bin/env bash

# @description Run the BATS suite under tests/, or forward arguments directly to
#              bats. Snapshots repo state (HEAD, config, index) before and after
#              and dies loudly if the suite mutated the real repo, even when bats
#              itself exited 0 — the repeat-tier cases create state dirs,
#              symlinks and large fixture files, so fixture escape is a real risk.
#
#              Deliberately serial: `bats --jobs` needs flock and GNU parallel,
#              both Linux-only in nixpkgs, and referencing them would break
#              evaluation of the devShell on aarch64-darwin.
#
#              `--awk=bwk` runs the suite with `awk` resolving to one-true-awk
#              (the nawk the devShell provides), which is the stock awk on macOS.
#              The hook and its scanner resolve `awk` from PATH, so a shim dir
#              holding a single `awk -> nawk` symlink, prepended to PATH, is all
#              it takes to exercise that platform from Linux. The default run
#              keeps whatever `awk` the devShell puts first (gawk).
#
#              `--report DIR` adds bats' JUnit reporter, which writes
#              DIR/report.xml while leaving the terminal formatter alone --
#              `--report-formatter`, not `--formatter`, because the compat legs'
#              job logs are the first thing a reader looks at when a macOS-only
#              failure appears and swapping them for XML would trade the
#              artifact against the thing it exists to supplement (#83). DIR is
#              created if absent, because bats requires `--output` to name a
#              directory that already exists. The report lands whether the suite
#              passed or failed; the failing case is the one it exists for.
# @arg $@ args optional `--awk=bwk` and `--report DIR` in any order, then bats
#         arguments or test paths; omit paths to run all of tests/
# @exitcode 0 all tests passed and the repo was left untouched
# @exitcode 1 bats missing, nawk missing under --awk=bwk, --report given without
#             a directory, a test failed, or the suite mutated the repo

set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR

function die() {
  printf '[%s] FATAL: %s\n' "${0##*/}" "$1" >&2
  exit 1
}

# @description Print one line per watched repo artifact: HEAD sha, config hash,
#              index hash. Used before and after the suite to detect fixture
#              escapes onto the real repo.
# @noargs
# @stdout three KEY=value lines
function repo_state() {
  local head_ref config_hash index_hash config_path index_path
  head_ref="$(git -C "${REPO_DIR}" rev-parse --quiet --verify HEAD || printf 'NO-HEAD')"
  config_path="$(git -C "${REPO_DIR}" rev-parse --path-format=absolute --git-path config)"
  index_path="$(git -C "${REPO_DIR}" rev-parse --path-format=absolute --git-path index)"
  config_hash="$([[ -f "${config_path}" ]] && git hash-object "${config_path}" || printf 'ABSENT')"
  index_hash="$([[ -f "${index_path}" ]] && git hash-object "${index_path}" || printf 'ABSENT')"
  printf 'HEAD=%s\nconfig=%s\nindex=%s\n' "${head_ref}" "${config_hash}" "${index_hash}"
}

# @description Prepend a shim directory to PATH in which `awk` is one-true-awk,
#              then prove the swap took by version string: BWK prints
#              `awk version YYYYMMDD`, gawk `GNU Awk`, mawk `mawk`. A suite that
#              silently ran under gawk would pass for the wrong reason.
# @noargs
# @exitcode 0 `awk` now resolves to one-true-awk
# @exitcode 1 nawk is not on PATH, or the shim did not take
function use_bwk_awk() {
  local nawk shim version
  if ! nawk="$(command -v nawk)"; then
    die "nawk not found on PATH — --awk=bwk needs the devShell's one-true-awk"
  fi
  shim="$(mktemp --directory)"
  ln --symbolic "${nawk}" "${shim}/awk"
  export PATH="${shim}:${PATH}"
  version="$(awk --version 2>&1 | head --lines=1)"
  case "${version}" in
    'awk version '*) log "awk is one-true-awk: ${version}" ;;
    *) die "expected one-true-awk at the head of PATH, got: ${version}" ;;
  esac
}

function log() {
  printf '[%s] %s\n' "${0##*/}" "$1" >&2
}

function main() {
  # Unset BASH_ENV so bats' per-test subshells do not re-source the user's
  # interactive ~/.bashrc. That re-source fires for every test subshell, making
  # the suite dramatically slower and clobbering exported vars in child shells.
  unset BASH_ENV

  if ! command -v bats > /dev/null 2>&1; then
    die "bats not found on PATH — run './.ci/in-devshell ./run-tests' or 'just test'"
  fi

  # Leading flags, in any order, consumed before anything reaches bats. A loop
  # rather than a chain of `if`s so `--awk=bwk --report DIR` and
  # `--report DIR --awk=bwk` are the same invocation -- CI passes one, a person
  # debugging locally passes the other, and an order-dependent parse would make
  # one of them silently forward `--awk=bwk` to bats as a test path.
  local report_dir=''
  while (($# > 0)); do
    case "$1" in
      '--awk=bwk')
        shift
        use_bwk_awk
        ;;
      '--report')
        if (($# < 2)); then
          die '--report needs a directory argument'
        fi
        report_dir="$2"
        shift 2
        ;;
      *) break ;;
    esac
  done

  local -a report_args=()
  if [[ -n "${report_dir}" ]]; then
    # bats' own --help says the --output directory "must exist"; it does not
    # create one. Creating it here is what makes `--report` safe to point at a
    # per-run path like ${RUNNER_TEMP}/bats-junit that nothing else made.
    mkdir --parents "${report_dir}"
    # --report-formatter, NOT --formatter: the first writes JUnit to a file and
    # leaves the terminal formatter alone, the second REPLACES terminal output.
    # The compat legs' job logs are the first thing a reader looks at when a
    # macOS-only failure appears, and swapping them for XML would trade the
    # artifact against the thing it exists to supplement (#83).
    report_args=(--report-formatter junit --output "${report_dir}")
  fi

  local before after status=0
  before="$(repo_state)"
  # `${report_args[@]+"${report_args[@]}"}` rather than a plain
  # `"${report_args[@]}"`: bash 4.2 and 4.3 treat expanding an EMPTY array under
  # `set -u` as an unbound-variable error, and .ci/in-devshell advertises a 4.2
  # floor. Same idiom as .ci/check-err-trap-hygiene and the guard body use, and
  # it preserves element boundaries -- a report directory whose path contains a
  # space still reaches bats as one argument.
  if (($# == 0)); then
    bats --recursive --print-output-on-failure \
      ${report_args[@]+"${report_args[@]}"} "${REPO_DIR}/tests" || status=$?
  else
    bats ${report_args[@]+"${report_args[@]}"} "$@" || status=$?
  fi
  after="$(repo_state)"

  if [[ "${before}" != "${after}" ]]; then
    die "test suite mutated the real repo — before: [${before//$'\n'/ }] after: [${after//$'\n'/ }]"
  fi
  # A gate reporting its own verdict is not a crash: drop the ERR trap so the
  # bats output above is the last thing the reader sees (#43, invariant 6).
  trap - ERR
  return "${status}"
}

main "$@"
